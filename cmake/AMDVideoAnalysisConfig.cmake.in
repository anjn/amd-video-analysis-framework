@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
find_dependency(Threads)
pkg_check_modules(VA REQUIRED IMPORTED_TARGET libva libva-drm)
if(@AMDVA_BUILD_PLUGINS@)
  pkg_check_modules(GST REQUIRED IMPORTED_TARGET gstreamer-1.0>=1.28.2 gstreamer-base-1.0 gstreamer-video-1.0 gstreamer-va-1.0 gstreamer-analytics-1.0 gstreamer-allocators-1.0)
endif()
if(@AMDVA_BUILD_STREAMING@)
  pkg_check_modules(CODECPARSERS REQUIRED IMPORTED_TARGET gstreamer-codecparsers-1.0)
endif()
pkg_check_modules(MEDIA_GST REQUIRED IMPORTED_TARGET gstreamer-1.0>=1.28.2 gstreamer-codecparsers-1.0 gstreamer-rtsp-server-1.0)
pkg_check_modules(MEDIA_GL REQUIRED IMPORTED_TARGET egl glesv2)
include("${CMAKE_CURRENT_LIST_DIR}/AMDVideoAnalysisTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/AmdvaHostLibraries.cmake")
find_path(AMDVA_HIP_INCLUDE hip/hip_runtime_api.h HINTS "${AMDVA_ROCM_ROOT}/include" "@AMDVA_HIP_INCLUDE@" REQUIRED)
set_property(TARGET AMDVA::amdva_runtime APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${AMDVA_HIP_INCLUDE}")
check_required_components(AMDVideoAnalysis)
